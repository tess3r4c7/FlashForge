// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  INVENTORY_RESERVED
  PAYMENT_PROCESSING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  pricePaise  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory  Inventory?
  orderItems OrderItem[]
}

model Inventory {
  id                Int      @id @default(autoincrement())
  productId         Int      @unique
  availableQuantity Int
  reservedQuantity  Int      @default(0)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id               Int         @id @default(autoincrement())
  userId           Int
  status           OrderStatus @default(PENDING)
  totalAmountPaise Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  // Background jobs (Phase 5B) look for orders that have been in one status
  // for too long: "WHERE status = 'INVENTORY_RESERVED' AND updatedAt < ...".
  @@index([status, updatedAt])
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int
  unitPricePaise Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id               Int           @id @default(autoincrement())
  orderId          Int           @unique
  status           PaymentStatus @default(PENDING)
  amountPaise      Int
  transactionId    String?
  // How many times the stuck-payment job has re-sent payment.requested (Phase 5B)
  recoveryAttempts Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

// Transactional outbox (Phase 4).
// Events are INSERTed here inside the same database transaction as the
// business change (order created, payment requested, ...). A background
// relay later publishes them to RabbitMQ and sets publishedAt.
// If RabbitMQ is down, rows simply wait here — nothing is lost.
model OutboxEvent {
  id          String    @id @db.Uuid // = eventId of the event envelope
  type        String // routing key, e.g. "payment.requested"
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime? // null = not yet published
  attempts    Int       @default(0) // failed publish attempts
  lastError   String?

  // The relay's query is "WHERE publishedAt IS NULL ORDER BY createdAt"
  @@index([publishedAt, createdAt])
}

// Idempotent consumers (Phase 5).
// RabbitMQ + the outbox deliver "at least once", so the same event can
// arrive twice. Before doing its work, a consumer inserts (consumer, eventId)
// here in the same transaction. If the row already exists, it's a duplicate
// and the work is skipped. The composite primary key does the deduplication.
model ProcessedEvent {
  consumer    String // e.g. "notification-worker"
  eventId     String
  processedAt DateTime @default(now())

  @@id([consumer, eventId])
  @@index([processedAt]) // for cleaning up old rows
}

// API idempotency keys (Phase 5B).
// A client that retries POST /orders (timeout, flaky mobile network) sends
// the same Idempotency-Key header. The first request stores its response
// here, in the same transaction as the order; retries get that response back
// instead of creating a second order.
model IdempotencyKey {
  userId         Int
  key            String
  requestHash    String // SHA-256 of the request body: same key + different body = client bug
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@id([userId, key]) // keys are scoped per user
  @@index([createdAt]) // for cleaning up old keys
}
