# Copy to .env for local development:  cp .env.example .env
# Values match docker-compose.yml. NEVER commit real secrets - .env is git-ignored.

DATABASE_URL="postgresql://flashforge:flashforge_dev@localhost:5432/flashforge"

# RabbitMQ. Management UI: http://localhost:15672
RABBITMQ_URL="amqp://flashforge:flashforge_dev@localhost:5672"

# Redis: rate limiting, product cache, idempotency cache (all disposable)
REDIS_URL="redis://localhost:6379"

# HTTP port for the API
PORT=3000

# Simulated payment gateway (src/services/payment-gateway.ts)
PAYMENT_DELAY_MS=500
PAYMENT_SUCCESS_RATE=0.8

# How many payments one worker process handles in parallel
PAYMENT_WORKER_PREFETCH=10

# Per-user limit on POST /orders and POST /orders/:id/pay
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=10000
PRODUCT_CACHE_TTL_SECONDS=30

# Optional (defaults live in the code that reads them):
# LOG_LEVEL=info
# RETRY_DELAYS_MS=1000,5000,30000        (src/messaging/rabbitmq.ts)
# RESERVATION_TTL_MS=                    (src/jobs/reservation-expiry.ts)
# STUCK_PAYMENT_AFTER_MS=                (src/jobs/stuck-payments.ts)
# OUTBOX_POLL_INTERVAL_MS=200            (src/messaging/outbox-relay.ts)
