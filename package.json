{
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqplib": "^2.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "dlq": "tsx src/scripts/dlq.ts",
    "loadtest:flash": "powershell -ExecutionPolicy Bypass -File loadtest/run.ps1 flash",
    "loadtest:sustained": "powershell -ExecutionPolicy Bypass -File loadtest/run.ps1 sustained",
    "loadtest:mixed": "powershell -ExecutionPolicy Bypass -File loadtest/run.ps1 mixed",
    "loadtest:verify": "tsx loadtest/verify-db.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
